---

<footer class="flex justify-around text-(--color-muted) mt-10 p-5 text-sm items-center gap-4 border-t font-mono border-(--color-border)">
  <p id="copyright"></p>
  <span id="time"></span>
  <a href="#top " class="hover:underline underline-offset-8">
    Volver arriba
  </a>
</footer>

<script>
  const getDate = () => {
    return new Date();
  };

  const date = getDate();
  const p = document.getElementById('copyright');
  const time = document.getElementById('time');

  if (time) {
    time.textContent = `Buenos Aires ${date.toLocaleTimeString()}`;
  }

  if (p) {
    p.textContent = `© ${date.getFullYear() ?? 2026} Ezequiel Luci.`;
  }

  setInterval(() => {
    const date = getDate();
    if (time) {
      time.textContent = `Buenos Aires ${date.toLocaleTimeString()}`;
    }
  }, 1000);
</script>
