---
import Footer from '@/components/common/Footer.astro';
import '../styles/tokens.css';
import Header from '@/components/Header.astro';
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Ezequiel Luci - Portfolio</title>
  </head>
  <body class="absolute top-0 -z-10 w-full animate-blurred-fade-in animate-duration-700 animate-fill-mode-both bg-(--color-surface)">
    <div class="absolute bottom-auto left-auto right-0 top-0 h-125 w-125 -z-10 translate-x-[-30%] translate-y-[20%] rounded-full bg-[rgba(173,109,244,0.5)] opacity-50 blur-[80px]"></div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
